#!/usr/bin/env bash
# horus-web — Start the Horus web interface
# Usage: ./horus-web [--port 8080] [--host 127.0.0.1] [--debug]
#
# Auto-creates .venv, installs Flask, and starts the server.
# No manual setup required.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PYTHON=""
VENV_DIR=".venv"
PORT="8080"
HOST="127.0.0.1"
DEBUG=""

# ── Parse args ───────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)  PORT="$2";   shift 2 ;;
        --host)  HOST="$2";   shift 2 ;;
        --debug) DEBUG="--debug"; shift ;;
        -h|--help)
            echo "Usage: ./horus-web [--port 8080] [--host 127.0.0.1] [--debug]"
            echo ""
            echo "Starts the Horus web interface."
            echo "Auto-creates .venv and installs dependencies if needed."
            exit 0
            ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# ── Find Python 3.10+ ────────────────────────────────────────────────────────
for candidate in /opt/homebrew/bin/python3.14 /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 /opt/homebrew/bin/python3.10 python3; do
    if command -v "$candidate" &>/dev/null; then
        version=$("$candidate" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)
        major=$(echo "$version" | cut -d. -f1)
        minor=$(echo "$version" | cut -d. -f2)
        if [[ "$major" -ge 3 && "$minor" -ge 10 ]]; then
            PYTHON="$candidate"
            echo "[horus-web] Using Python $version ($candidate)"
            break
        fi
    fi
done

if [[ -z "$PYTHON" ]]; then
    echo "[horus-web] ERROR: Python 3.10+ not found."
    echo "  Install via: brew install python@3.14"
    exit 1
fi

# ── Create venv if missing ───────────────────────────────────────────────────
if [[ ! -d "$VENV_DIR" ]]; then
    echo "[horus-web] Creating virtual environment..."
    "$PYTHON" -m venv "$VENV_DIR"
    echo "[horus-web] Upgrading pip..."
    "$VENV_DIR/bin/pip" install --upgrade pip setuptools -q
    echo "[horus-web] Installing dependencies..."
    "$VENV_DIR/bin/pip" install -e ".[web]" -q
    echo "[horus-web] Done."
else
    # Check if Flask is installed; install if missing
    if ! "$VENV_DIR/bin/python3" -c "import flask" &>/dev/null; then
        echo "[horus-web] Installing missing dependencies..."
        "$VENV_DIR/bin/pip" install -e ".[web]" -q
    fi
fi

# ── Start server ─────────────────────────────────────────────────────────────
echo "[horus-web] Starting at http://${HOST}:${PORT}"
echo "[horus-web] Press Ctrl+C to stop."
echo ""
exec "$VENV_DIR/bin/python3" -m horus.web --host "$HOST" --port "$PORT" $DEBUG
