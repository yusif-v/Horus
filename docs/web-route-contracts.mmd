%%{init: {'theme': 'dark', 'themeVariables': {'primaryColor': '#1a1a2e', 'primaryTextColor': '#e0e0e0', 'primaryBorderColor': '#4a9eff', 'lineColor': '#aaa', 'secondaryColor': '#2e1a2e', 'tertiaryColor': '#1a2e1a', 'background': '#0d1117', 'mainBkg': '#161b22', 'nodeBorder': '#30363d', 'clusterBkg': '#1c2128', 'titleColor': '#e0e0e0', 'edgeLabelBackground': '#1c2128'}}}%%
graph TD
    classDef html fill:#1a1a2e,stroke:#4a9eff,color:#e0e0e0,rx:6,ry:6
    classDef api fill:#2e1a2e,stroke:#bf4aff,color:#e0e0e0,rx:6,ry:6
    classDef planned fill:#1a2e1a,stroke:#4aff4a,color:#e0e0e0,stroke-dasharray: 5 5,rx:6,ry:6
    classDef param fill:#1a1a1a,stroke:#666,color:#ccc,rx:4,ry:4

    subgraph Routes[" "]
        direction TB

        D["GET /\n<b>Dashboard</b>"]:::html

        S["GET /search?q={q}\n<b>Search</b>"]:::html

        CD["GET /cve/{cve_id}\n<b>CVE Detail</b>"]:::html

        CV["GET /cves\n<b>CVE Index</b>"]:::html
        CV_P1["q: page=1"]:::param
        CV_P2["q: severity=Critical|High|Medium|Low"]:::param
        CV_P3["q: kev=1"]:::param
        CV_P4["q: sort=cvss|epss|exploit|date"]:::param
        CV_P5["q: window=day|week|month|all"]:::param
        CV_P6["q: tag={tag} *"]:::param
        CV_P7["q: category={cat} *"]:::param
        CV_P1 --> CV
        CV_P2 --> CV
        CV_P3 --> CV
        CV_P4 --> CV
        CV_P5 --> CV
        CV_P6 --> CV
        CV_P7 --> CV

        PL["GET /pocs\n<b>PoC List</b>"]:::html
        PL_P1["q: page=1"]:::param
        PL_P2["q: source={source}"]:::param
        PL_P1 --> PL
        PL_P2 --> PL

        TQ["GET /triage\n<b>Triage Queue</b>"]:::html
        TQ_P1["q: page=1"]:::param
        TQ_P2["q: lens=all|kev|imminent|weaponized"]:::param
        TQ_P1 --> TQ
        TQ_P2 --> TQ

        AS["GET /api/stats\n<b>Stats JSON</b>"]:::api
        AC["GET /api/cve/{cve_id}\n<b>CVE JSON</b>"]:::api

        NF["GET /news\n<b>News Feed</b>"]:::planned
        NF_P1["q: source=x_twitter|rss|vendor"]:::param
        NF_P2["q: urgency=critical|high|normal|low"]:::param
        NF_P3["q: cve={cve_id}"]:::param
        NF_P1 --> NF
        NF_P2 --> NF
        NF_P3 --> NF

        NA["GET /api/news\n<b>News JSON</b>"]:::planned
        WL["GET /watchlist\n<b>Watchlist</b>"]:::planned
        WA["GET|POST|DELETE /api/watchlist\n<b>Watchlist API</b>"]:::planned
        WS["WS /ws/live\n<b>Realtime</b>"]:::planned
    end

    D -.- S
    S -.- CD
    CD -.- CV
    CV -.- PL
    PL -.- TQ
    TQ -.- AS
    AS -.- AC
    AC -.- NF
    NF -.- NA
    NA -.- WL
    WL -.- WA
    WA -.- WS
