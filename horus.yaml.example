# Horus server config example — copy to horus.yaml and customize.
# Pass via: python3 -m horus --server --config horus.yaml
# All keys are optional; omitted keys fall back to defaults in horus/server.py.

# External plugin directories (folder layout: <kind>/<name>/ with plugin.toml + main.py).
plugin_dirs:
  - ~/.config/horus/plugins

# Per-plugin overrides keyed by plugin name (bundled AND external).
# Each entry may set: enabled, interval_seconds, config (plugin-specific).
plugins:
  nvd:
    interval_seconds: 3600   # 1h  — NVD updates roughly every 2h
  x_twitter:
    interval_seconds: 1800   # 30m — social moves fast
  github:
    interval_seconds: 3600   # 1h  — search API rate-limited
  gitlab:
    interval_seconds: 3600   # 1h
  exploitdb:
    interval_seconds: 7200   # 2h  — slower moving
  codeberg:
    interval_seconds: 3600   # 1h
  news:
    interval_seconds: 3600   # 1h
  epss:
    interval_seconds: 86400  # 24h — daily CSV
  kev:
    interval_seconds: 86400  # 24h — daily catalog
  otx:
    interval_seconds: 86400  # 24h — daily feed
  darkweb:
    interval_seconds: 86400  # 24h — daily feed
  telegram:
    enabled: true
    config:
      bot_token: "YOUR_BOT_TOKEN"  # or set TELEGRAM_BOT_TOKEN env var

# AI news feed — score new RSS articles with AI, post the important ones to /posts.
news_feed:
  enabled: true
  threshold: 80           # min importance score (0-100) to become a post
  max_articles_per_run: 50

# How often the scheduler wakes up to check which sources are due.
check_every_seconds: 60

# Embedded web UI (gunicorn). Disable if you only want the data pipeline.
web:
  enabled: true
  host: 127.0.0.1
  port: 8080
  workers: 2
  # If gunicorn isn't installed, fall back to Flask's dev server (with a
  # warning). Set false to fail-fast in production.
  allow_dev_fallback: true

# Telegram bot for notifications. Token from @BotFather.
# The bot listens for /start <token> to link user accounts, then sends
# notifications when watchlist CVEs, KEV additions, EPSS jumps, etc. occur.
# Token can also be set via TELEGRAM_BOT_TOKEN env var.
# Bot username (without @) can be set via TELEGRAM_BOT_USERNAME env var.
# To disable, set enabled: false or omit this section entirely.
#
# NOTE: the top-level `telegram:` block is deprecated. Configure the bot via
# `plugins.telegram.config` (above) instead. The old block is folded into it
# with a DeprecationWarning.
# telegram:
#   bot_token: "YOUR_BOT_TOKEN"
