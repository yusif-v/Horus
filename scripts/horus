#!/usr/bin/env bash
# ─── Horus Management CLI ────────────────────────────────────────────────────
# Installed at /usr/local/bin/horus on the server.
#
# Usage:
#   horus update          Pull latest from git + rebuild + restart
#   horus start           Start Horus
#   horus stop            Stop Horus
#   horus restart         Restart without rebuild
#   horus status          Show container status + recent logs
#   horus logs            Tail live logs
#   horus backup          Back up the SQLite database
#   horus config          Open .env in $EDITOR
#   horus health          Check /api/health endpoint
#   horus help            Show this help

set -euo pipefail

HORUS_DIR="${HORUS_DIR:-/opt/horus}"
DEPLOY="${HORUS_DIR}/scripts/deploy.sh"

# ── Colors ────────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

log()  { echo -e "${GREEN}[horus]${NC} $*"; }
warn() { echo -e "${YELLOW}[horus]${NC} $*"; }
err()  { echo -e "${RED}[horus]${NC} $*" >&2; }
info() { echo -e "${CYAN}[horus]${NC} $*"; }

require_horus_dir() {
    if [[ ! -d "$HORUS_DIR" ]]; then
        err "Horus directory not found: $HORUS_DIR"
        err "Run the installer: bash <(curl -fsSL https://raw.githubusercontent.com/yusif-v/Horus/main/scripts/server-install.sh)"
        exit 1
    fi
    if [[ ! -f "$DEPLOY" ]]; then
        err "deploy.sh not found in $HORUS_DIR/scripts/"
        exit 1
    fi
}

cmd_update() {
    require_horus_dir
    cd "$HORUS_DIR"

    # Try git-based update first (requires GitHub access)
    if git -C "$HORUS_DIR" fetch origin 2>/dev/null; then
        local branch
        branch=$(git -C "$HORUS_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        local behind
        behind=$(git -C "$HORUS_DIR" rev-list --count HEAD..origin/"$branch" 2>/dev/null || echo "?")

        if [[ "$behind" == "0" ]]; then
            warn "Already on latest commit (branch: $branch). Rebuilding anyway..."
        else
            log "Pulling $behind new commit(s) from origin/$branch..."
            git -C "$HORUS_DIR" pull origin "$branch"
        fi

        log "Rebuilding Docker image (native)..."
        docker build -t horus:latest "$HORUS_DIR"
        docker tag horus:latest horus-app-horus:latest

        log "Restarting..."
        docker compose -f "$HORUS_DIR/docker-compose.yml" down 2>/dev/null || true
        docker compose -f "$HORUS_DIR/docker-compose.yml" up -d
        do_healthcheck
    else
        # No GitHub access: check if a fresh image was loaded by push-update.sh
        warn "Cannot reach GitHub — checking for a locally loaded image..."
        if docker images --format '{{.Repository}}:{{.Tag}}' | grep -q '^horus:latest$'; then
            log "horus:latest found — restarting..."
            docker compose -f "$HORUS_DIR/docker-compose.yml" down 2>/dev/null || true
            docker tag horus:latest horus-app-horus:latest
            docker compose -f "$HORUS_DIR/docker-compose.yml" up -d
            do_healthcheck
        else
            err "No new image and no GitHub access."
            err "Push an update from your dev machine: ./scripts/push-update.sh"
            exit 1
        fi
    fi

    log ""
    log "Update complete."
    local version
    version=$(git -C "$HORUS_DIR" describe --tags --always 2>/dev/null || \
              git -C "$HORUS_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    log "Running: $version"
}

do_healthcheck() {
    local port
    port=$(grep -E '^HORUS_HOST_PORT=' "$HORUS_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "8081")
    port="${port:-8081}"
    local url="http://localhost:${port}/api/health"
    local attempts=0
    while [[ $attempts -lt 15 ]]; do
        if curl -sf "$url" | python3 -c "import sys,json; exit(0 if json.load(sys.stdin)['status']=='ok' else 1)" 2>/dev/null; then
            log "Horus is healthy ✓"
            return 0
        fi
        attempts=$((attempts+1))
        sleep 2
    done
    err "Horus did not become healthy. Check: horus logs"
    return 1
}

cmd_start() {
    require_horus_dir
    cd "$HORUS_DIR"
    bash "$DEPLOY"
}

cmd_stop() {
    require_horus_dir
    cd "$HORUS_DIR"
    bash "$DEPLOY" --stop
}

cmd_restart() {
    require_horus_dir
    cd "$HORUS_DIR"
    log "Restarting Horus (no rebuild)..."
    docker compose -f "$HORUS_DIR/docker-compose.yml" restart horus
    log "Restarted."
}

cmd_status() {
    require_horus_dir
    cd "$HORUS_DIR"
    bash "$DEPLOY" --status
}

cmd_logs() {
    require_horus_dir
    cd "$HORUS_DIR"
    bash "$DEPLOY" --logs
}

cmd_backup() {
    require_horus_dir
    cd "$HORUS_DIR"
    local backup_dir="$HORUS_DIR/backups"
    mkdir -p "$backup_dir"
    local stamp
    stamp="$(date +%Y%m%d-%H%M%S)"
    local dest="$backup_dir/horus.db.${stamp}.bak"
    log "Backing up database → $dest"
    if docker compose -f "$HORUS_DIR/docker-compose.yml" cp horus:/app/state/horus.db "$dest" 2>/dev/null; then
        log "Backup saved ($(du -h "$dest" | cut -f1))"
        ls -1t "$backup_dir"/horus.db.*.bak 2>/dev/null | tail -n +11 | xargs -r rm -f
    else
        rm -f "$dest"
        err "Could not back up DB (is Horus running?)"
        exit 1
    fi
}

cmd_config() {
    require_horus_dir
    local env_file="$HORUS_DIR/.env"
    if [[ ! -f "$env_file" ]]; then
        warn ".env not found. Copying .env.sample..."
        cp "$HORUS_DIR/.env.sample" "$env_file"
    fi
    "${EDITOR:-nano}" "$env_file"
    warn "Restart Horus to apply changes: horus restart"
}

cmd_health() {
    require_horus_dir
    cd "$HORUS_DIR"
    local port
    port=$(grep -E '^HORUS_HOST_PORT=' "$HORUS_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "8081")
    port="${port:-8081}"
    local url="http://localhost:${port}/api/health"
    info "Checking $url ..."
    if curl -sf "$url" | python3 -m json.tool; then
        log "Horus is healthy."
    else
        err "Health check failed. Run: horus logs"
        exit 1
    fi
}

cmd_help() {
    echo ""
    echo -e "${CYAN}Horus CTI Platform — Management CLI${NC}"
    echo ""
    echo "  horus update     Pull latest from git + rebuild + restart"
    echo "  horus start      Start Horus (first deploy)"
    echo "  horus stop       Stop Horus"
    echo "  horus restart    Restart without rebuild"
    echo "  horus status     Container status + recent logs"
    echo "  horus logs       Tail live logs (Ctrl+C to exit)"
    echo "  horus backup     Back up the SQLite database"
    echo "  horus config     Edit .env configuration"
    echo "  horus health     Check /api/health endpoint"
    echo "  horus help       Show this help"
    echo ""
    echo "  Install dir:     $HORUS_DIR"
    echo "  Web UI:          http://$(hostname -I | awk '{print $1}'):8081"
    echo ""
}

# ── Main ──────────────────────────────────────────────────────────────────────

case "${1:-help}" in
    update)   cmd_update ;;
    start)    cmd_start ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    status)   cmd_status ;;
    logs)     cmd_logs ;;
    backup)   cmd_backup ;;
    config)   cmd_config ;;
    health)   cmd_health ;;
    help|--help|-h) cmd_help ;;
    *)
        err "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
