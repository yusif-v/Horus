# ─── Horus Configuration ─────────────────────────────────────────────────────
# Copy this file to .env and edit values as needed.
# All variables are OPTIONAL unless marked [REQUIRED].
# Existing environment variables always win over values in this file.

# ─── Core ────────────────────────────────────────────────────────────────────
# Secret key for Flask session signing. Leave empty = auto-generate on first run.
HORUS_SECRET_KEY=
# Log level: DEBUG, INFO, WARNING, ERROR
HORUS_LOG_LEVEL=INFO

# ─── Web Server ───────────────────────────────────────────────────────────────
# Host the dev/gunicorn server binds to
HORUS_WEB_HOST=0.0.0.0
# Port
HORUS_WEB_PORT=8080

# ─── Data Sources ─────────────────────────────────────────────────────────────
# Comma-separated list of sources to enable on every pipeline run.
# Available: nvd, x_twitter, github, gitlab, codeberg, exploitdb, news, resources
# Only sources listed here will run; others are silently skipped.
# Note: nvd is always required and cannot be disabled.
HORUS_SOURCES_ENABLED=nvd,github,gitlab,codeberg,exploitdb,news

# ─── Source Credentials (Optional) ────────────────────────────────────────────
# GitHub: enables GitHub PoC repository search. Create a token at:
#   https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=
# Codeberg: enables Codeberg PoC repository search.
CODEBERG_TOKEN=
# X/Twitter: enables social signal + URL discovery.
# Current implementation requires Chrome auth flow (see docs).
# Future: native API token support.
X_TOKEN=

# ─── Telegram Bot (Optional) ─────────────────────────────────────────────────
# Enables Telegram notifications and bot commands.
# Get a token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Bot username (required for deep-link generation)
TELEGRAM_BOT_USERNAME=

# ─── Pipeline Tunables ────────────────────────────────────────────────────────
# How many days back to fetch from NVD API (default: 2)
NVD_LOOKBACK_DAYS=2
# Maximum lookback when no data exists (default: 14)
NVD_MAX_LOOKBACK_DAYS=14
# Minimum GitHub repo stars to count as a meaningful PoC (default: 1)
MIN_REPO_STARS=1
# Max repo age in days to include (default: 90)
MAX_REPO_AGE_DAYS=90
